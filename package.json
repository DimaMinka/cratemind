{
  "name": "cratemind",
  "version": "0.1.0",
  "description": "AI-driven TUI audio file vibe sorter and router",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:pocket",
    "build:node": "tsc",
    "build:pocket": "vite build -c pocket-web/vite.config.ts",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.tsx",
    "pocket": "tsx src/services/pocket/pocketCli.ts",
    "pocket:certs": "node scripts/generate-pocket-certs.mjs",
    "pocket:sandbox": "tsx src/scripts/pocket-sandbox.ts",
    "telegram-login": "ts-node src/scripts/telegram-login.ts",
    "test": "vitest run",
    "test:pocket": "vitest run tests/pocket",
    "test:client": "vitest run tests/pocket-web",
    "test:e2e": "vitest run tests/e2e",
    "dev:pocket": "vite --config pocket-web/vite.config.ts",
    "check:pocket": "tsc -p pocket-web/tsconfig.json --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'pocket-web/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'pocket-web/**/*.{ts,tsx,js,css,html,json}' 'tests/**/*.{ts,tsx}' README.md index.html eslint.config.mjs"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "ink": "^4.4.1",
    "input": "^1.0.1",
    "music-metadata": "^7.14.0",
    "p-queue": "^6.6.2",
    "react": "^18.2.0",
    "telegram": "^2.26.22",
    "zod": "^3.22.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "idb": "^8.0.4",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.73.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.3",
    "puppeteer-core": "^25.17.0",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
