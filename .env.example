# Gemini API configuration for track classification and embeddings
GEMINI_API_KEY=your-gemini-api-key-here

# Spotify integration credentials (optional, used for fetching audio features like BPM/Key)
SPOTIFY_CLIENT_ID=your-spotify-client-id-here
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here

# YouTube Data API Key (optional, used for playlist/video network scouting)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Engine DJ database path (optional, defaults to local Music folder)
# ENGINE_DB_PATH=~/Music/Engine Library/Database2/m.db

# Force manual mode (forces all tracks into manual confirmation checklist with pre-selected recommendation)
# Set to 'true' to enable, 'false' or leave commented out to disable
FORCE_MANUAL_MODE=false

# Mock mode (optional, simulates Gemini and external API calls for development and testing)
# MOCK_MODE=true

# Telegram Bulk Downloader integration (requires GramJS Userbot setup)
# TELEGRAM_API_ID=your-api-id
# TELEGRAM_API_HASH=your-api-hash
# TELEGRAM_SESSION_STRING="your-session-string"
# TELEGRAM_CHATS=channel_name,-100123456789

